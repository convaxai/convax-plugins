{
  "schema": "convax.plugin/8",
  "id": "hello-convax",
  "name": "Hello Convax",
  "description": "Checks the scoped Convax Plugin host connection and shows its active context.",
  "version": "0.2.2",
  "entry": "index.html",
  "capabilities": [],
  "contributes": {
    "canvas": {
      "renderer": {
        "create": true,
        "width": 480,
        "height": 300
      },
      "commands": [
        {
          "id": "context.refresh",
          "title": {
            "default": "Refresh context",
            "zh-CN": "刷新上下文"
          },
          "icon": "refresh",
          "target": {
            "type": "renderer-message",
            "message": "renderer.context.refresh"
          }
        }
      ],
      "toolbar": [
        {
          "id": "context-refresh-toolbar",
          "command": "context.refresh",
          "order": 10
        }
      ]
    },
    "skills": [
      {
        "name": "hello-convax-guide",
        "path": "skills/hello-convax-guide"
      }
    ]
  },
  "hostApi": {
    "major": 3,
    "required": [
      "host.context.get"
    ],
    "optional": []
  }
}
