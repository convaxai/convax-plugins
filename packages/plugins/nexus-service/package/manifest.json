{
  "schema": "convax.plugin/8",
  "id": "nexus-service",
  "name": "Convax",
  "description": "Connects Convax to AuthX identity and Nexus Application Access without exposing credentials or provider configuration.",
  "version": "1.0.10",
  "contributes": {
    "generation": {
      "models": [
        {
          "tool": "audio.generate",
          "name": "Convax Audio"
        },
        {
          "tool": "image.generate",
          "name": "Convax Image"
        },
        {
          "tool": "video.generate",
          "name": "Convax Video"
        }
      ],
      "tools": [
        {
          "id": "audio.generate",
          "title": "Convax Audio",
          "description": "Generate speech audio with a model discovered through the OpenRouter protocol.",
          "output": "audio",
          "acceptedInputs": []
        },
        {
          "id": "image.generate",
          "title": "Convax Image",
          "description": "Generate an image with a model discovered through the OpenRouter protocol.",
          "output": "image",
          "acceptedInputs": []
        },
        {
          "id": "video.generate",
          "title": "Convax Video",
          "description": "Generate a video with a model discovered through the OpenRouter protocol.",
          "output": "video",
          "acceptedInputs": [],
          "recovery": {
            "mode": "long-running-operation",
            "schema": "convax.generation-lro/1"
          }
        }
      ]
    },
    "llm": {
      "provider": {
        "id": "openrouter",
        "name": "Convax",
        "protocol": "openrouter"
      },
      "models": [
        {
          "id": "deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash"
        }
      ]
    },
    "service": {
      "actions": [
        "authorize",
        "reauthorize",
        "authorization.cancel",
        "checkout",
        "sign_out"
      ]
    }
  },
  "runtime": {
    "type": "mcp-stdio",
    "command": "convax-nexus-mcp"
  },
  "hostApi": {
    "major": 3,
    "required": [],
    "optional": []
  }
}
