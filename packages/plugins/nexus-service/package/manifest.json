{
  "schema": "convax.plugin/8",
  "id": "nexus-service",
  "name": "Convax Account",
  "description": "Connects Convax to your Convax Account for OpenRouter chat and live image-model generation through short-lived Data Tokens.",
  "version": "0.4.0",
  "contributes": {
    "generation": {
      "models": [
        {
          "tool": "image.generate",
          "name": "Nexus · OpenRouter Image"
        }
      ],
      "tools": [
        {
          "id": "image.generate",
          "title": "Nexus · OpenRouter Image",
          "description": "Generate an image with an image-output model available through the connected Nexus OpenRouter Provider.",
          "output": "image",
          "acceptedInputs": []
        }
      ]
    },
    "llm": {
      "provider": {
        "id": "openrouter",
        "name": "Nexus · OpenRouter"
      },
      "modelCatalog": "runtime",
      "models": [
        {
          "id": "deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash"
        }
      ]
    },
    "service": {
      "actions": [
        "authorize",
        "reauthorize",
        "authorization.cancel",
        "checkout",
        "sign_out"
      ]
    }
  },
  "runtime": {
    "type": "mcp-stdio",
    "command": "convax-nexus-mcp"
  },
  "hostApi": {
    "major": 2,
    "required": [],
    "optional": []
  }
}
