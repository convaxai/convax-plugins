{
  "schema": "convax.plugin/8",
  "id": "libtv-service",
  "name": "LibTV",
  "description": "通过 shortdrama-router 连接 LibTV 的图片和视频生成能力，使用受管理的 Web OAuth 并安全绑定唯一项目。",
  "version": "0.1.1",
  "capabilities": [],
  "contributes": {
    "generation": {
      "models": [
        {
          "tool": "image.generate",
          "name": "LibTV 图片"
        },
        {
          "tool": "video.generate",
          "name": "LibTV 视频"
        }
      ],
      "tools": [
        {
          "id": "image.generate",
          "title": "LibTV · 图片生成",
          "description": "使用 LibTV 根据提示词生成图片。",
          "output": "image",
          "acceptedInputs": [],
          "recovery": {
            "mode": "long-running-operation",
            "schema": "convax.generation-lro/1"
          }
        },
        {
          "id": "video.generate",
          "title": "LibTV · 视频生成",
          "description": "使用 LibTV 根据提示词生成视频。",
          "output": "video",
          "acceptedInputs": [],
          "recovery": {
            "mode": "long-running-operation",
            "schema": "convax.generation-lro/1"
          }
        }
      ]
    },
    "service": {
      "actions": [
        "authorize",
        "reauthorize",
        "authorization.cancel",
        "sign_out"
      ]
    }
  },
  "runtime": {
    "type": "mcp-stdio",
    "command": "convax-shortdrama-router-mcp",
    "args": [
      "--provider=libtv"
    ]
  },
  "hostApi": {
    "major": 3,
    "required": [],
    "optional": []
  }
}
