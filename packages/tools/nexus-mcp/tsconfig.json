{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2023", "DOM"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "target": "ES2023",
    "types": ["bun"]
  },
  "include": [
    "src/**/*.ts",
    "test/contract-*.test.ts",
    "test/v2-audio-generator.test.ts",
    "test/v2-credential-store.test.ts",
    "test/v2-image-generator.test.ts",
    "test/v2-llm-gateway.test.ts"
  ]
}
