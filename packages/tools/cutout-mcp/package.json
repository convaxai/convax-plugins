{
  "name": "@microvoid/convax-cutout-mcp",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "convax-cutout-mcp": "dist/convax-cutout-mcp"
  },
  "scripts": {
    "build": "bun scripts/build-release.ts --host && bun scripts/smoke-companion.ts",
    "build:release:darwin-arm64": "bun scripts/build-release.ts darwin arm64 && bun scripts/smoke-companion.ts dist/darwin-arm64/convax-cutout-mcp",
    "clean": "rm -rf dist vendor",
    "dev": "bun run build && ./dist/convax-cutout-mcp",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
